<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>OAuthTokenGenV2</RootNamespace>
    <AssemblyName>GitLabOAuthTokenGenerator</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Self-contained: bundles the .NET runtime so no SDK install needed -->
    <SelfContained>true</SelfContained>

    <!-- Single file: packs everything into one .exe -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Trim unused code to reduce file size -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>

    <!-- Enable ReadyToRun for faster startup -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Compress the single-file bundle -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Include native libraries in the single file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Application metadata -->
    <Product>GitLab OAuth Token Generator</Product>
    <Company>GitLab</Company>
    <Description>Generates OAuth 2.0 access tokens for the Visual Studio GitLab extension</Description>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>

    <!-- Windows application icon (optional, uncomment if you add an .ico file) -->
    <!-- <ApplicationIcon>app.ico</ApplicationIcon> -->
  </PropertyGroup>

  <!-- Suppress trim warnings for HttpClient and JSON serialization -->
  <ItemGroup>
    <TrimmerRootAssembly Include="System.Net.Http" />
    <TrimmerRootAssembly Include="System.Text.Json" />
  </ItemGroup>

</Project>

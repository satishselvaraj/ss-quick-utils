<UserControl x:Class="OAuthTokenGenExt.TokenGeneratorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- All styles use VS environment brushes so they adapt to Light/Dark/Blue themes -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"/>
        </Style>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ButtonTextKey}}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ButtonFaceKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ButtonTextKey}}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="StatusBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="🔐" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="GitLab OAuth Token Generator" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- SECTION 1: Token Status (always visible)                     -->
            <!-- ============================================================ -->

            <!-- Status Banner -->
            <Border x:Name="StatusBanner" Style="{StaticResource StatusBorder}"
                    Background="{DynamicResource {x:Static vs:VsBrushes.InfoBackgroundKey}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon" Text="⚪" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText" Text="Not Authorized" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail" Text="Click Authorize to generate a token." FontSize="11"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TokenCreatedText" Text="" FontSize="11"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="ExpiryText" Text="" FontSize="11"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Auto-Refresh Status -->
            <Border x:Name="AutoRefreshBanner" CornerRadius="4" Padding="10,6" Margin="0,4,0,8"
                    Background="{DynamicResource {x:Static vs:VsBrushes.InfoBackgroundKey}}"
                    BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="AutoRefreshText" Text="Auto-refresh active" FontSize="11"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.InfoTextKey}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Current Token Display (with copy button) -->
            <Border x:Name="TokenDisplayBanner" CornerRadius="4" Padding="12,8" Margin="0,4,0,8"
                    Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarGradientBeginKey}}"
                    BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Current Access Token" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="OnCopyTokenClick" Margin="8,0,0,0"
                                Style="{StaticResource BtnSecondary}" Padding="8,4" ToolTip="Copy token to clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Copy" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="TokenDisplayText" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                                 Background="Transparent" BorderThickness="0"
                                 TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="DuoSettingsStatus" Text="" FontSize="10"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Refresh Button (always visible, disabled when no token) -->
            <Button x:Name="RefreshButton" Click="OnRefreshClick" IsEnabled="False"
                    Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh Token Now" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ============================================================ -->
            <!-- SECTION 2: Credentials (read-only from .gitconfig)           -->
            <!-- ============================================================ -->

            <Separator Margin="0,4,0,12" Background="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"/>

            <TextBlock Text="Credentials" Style="{StaticResource HeaderStyle}"/>
            <TextBlock Style="{StaticResource HintStyle}" Text="Auto-loaded from ~/.gitconfig. Edit your .gitconfig to change these values."/>

            <!-- GitLab URL -->
            <TextBlock Text="GitLab URL" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="GitLabUrlInput" Style="{StaticResource InputStyle}" IsReadOnly="True"
                     ToolTip="Loaded from ~/.gitconfig [credential] section. Edit .gitconfig to change."/>

            <!-- Application ID -->
            <TextBlock Text="Application ID (client_id)" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="ClientIdInput" Style="{StaticResource InputStyle}" IsReadOnly="True"
                     ToolTip="Loaded from ~/.gitconfig gitLabDevClientId. Edit .gitconfig to change."/>

            <!-- Application Secret (with show/hide toggle) -->
            <TextBlock Text="Application Secret" Style="{StaticResource LabelStyle}"/>
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="SecretToggleButton" DockPanel.Dock="Right" Click="OnToggleSecretClick"
                        ToolTip="Show/Hide secret" Cursor="Hand" Margin="4,0,0,0"
                        Background="{DynamicResource {x:Static vs:VsBrushes.ButtonFaceKey}}"
                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                        BorderThickness="1" Padding="6,4" VerticalAlignment="Stretch">
                    <TextBlock x:Name="SecretToggleIcon" Text="👁" FontSize="13"/>
                </Button>
                <Grid>
                    <PasswordBox x:Name="ClientSecretInput" Style="{StaticResource PasswordStyle}" IsEnabled="False"
                                 Margin="0" Visibility="Visible"
                                 ToolTip="Loaded from ~/.gitconfig gitLabDevClientSecret. Edit .gitconfig to change."/>
                    <TextBox x:Name="ClientSecretRevealed" Style="{StaticResource InputStyle}" IsReadOnly="True"
                             Margin="0" Visibility="Collapsed" FontFamily="Consolas"
                             ToolTip="Loaded from ~/.gitconfig gitLabDevClientSecret. Edit .gitconfig to change."/>
                </Grid>
            </DockPanel>

            <!-- ============================================================ -->
            <!-- SECTION 3: Authorize                                         -->
            <!-- ============================================================ -->

            <Separator Margin="0,12,0,12" Background="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"/>

            <WrapPanel Margin="0,0,0,4">
                <Button x:Name="AuthorizeButton" Style="{StaticResource BtnPrimary}" Click="OnAuthorizeClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Authorize with GitLab" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock x:Name="AuthorizeHint" Style="{StaticResource HintStyle}"
                       Text="Opens GitLab in your browser. The token is captured automatically after you authorize."/>

            <!-- Listening Status (shown while waiting for callback) -->
            <Border x:Name="ListeningBanner" CornerRadius="4" Padding="10,6" Margin="0,4,0,8"
                    Background="{DynamicResource {x:Static vs:VsBrushes.InfoBackgroundKey}}"
                    BorderBrush="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"
                    BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ListeningText" Text="Waiting for authorization callback..."
                               FontSize="11" Foreground="{DynamicResource {x:Static vs:VsBrushes.InfoTextKey}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- SECTION 4: Activity Log                                      -->
            <!-- ============================================================ -->

            <TextBlock Text="Activity Log" Style="{StaticResource LabelStyle}" Margin="0,8,0,4"/>
            <Border CornerRadius="4" Padding="10" MaxHeight="200" Margin="0,0,0,8"
                    Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarGradientBeginKey}}"
                    BorderBrush="{DynamicResource {x:Static vs:VsBrushes.PanelBorderKey}}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogOutput" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Manual Code Entry removed - the loopback listener handles this automatically -->

        </StackPanel>
    </ScrollViewer>
</UserControl>
